print('\nB. Write a function safe_int(text) that turns a string into an int')
def safe_int(text):
    """Turn text into an int; return None when it is not a number."""
    text = text.strip()                    #strip use for cutting space
    if text.lstrip("-").isdigit():         #lstrip=left strip # "42" or "-42"
        return int(text)
    try:
        return int(float(text))            # "3.9" -> 3
    except ValueError:
        return None                        # "abc", "", "12a"

for sample in ["42", " -8 ", "3.9", "abc", ""]:
    print(repr(sample), "->", safe_int(sample))

print('\nC. Ask user to input 2 numbers')
input1 = input("Enter the first number: ") 
