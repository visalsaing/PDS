print('\nA. Write is_leap(year) using one boolean expression with and / or.')
def is_leap(year):
    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0

print("Testing is_leap:") 
print("2024 is leap:", is_leap(2024))
print("2023 is leap:", is_leap(2023))

print('\nB. Write days_in_month(month, year)')
def days_in_month(month, year):
    if month < 1 or month > 12:
        return None
    if month == 2:
        return 29 if is_leap(year) else 28
    if month in (4, 6, 9, 11):
        return 30
    return 31

print("Testing days_in_month:")
print("Feb 2024 days:", days_in_month(2, 2024))
print("Feb 2025 days:", days_in_month(2, 2025))
print("April days:", days_in_month(4, 2026))

print('\nC. Specific target verification')
print('    Leap status evaluation    ')
for y in [1900, 2000, 2024, 2026]:
    print(y, "leap" if is_leap(y) else "not leap")
print("Feb 2024:", days_in_month(2, 2024), "| Feb 2026:", days_in_month(2, 2026),
      "| Apr:", days_in_month(4, 2026), "| month 13:", days_in_month(13, 2026))

print('\nD. Count the leap years from 2000 to 2100')
leap_count = 0
for y in range(2000, 2101):
    if is_leap(y):
        leap_count += 1
print("Leap years from 2000 to 2100:", leap_count)
