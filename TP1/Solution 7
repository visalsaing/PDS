print('\nA. Test the three functions with 2026, 12321 and 9875.')
def digit_sum(n):
    n = abs(n)
    total = 0
    while n > 0:
        total += n % 10       
        n //= 10              
    return total


def reverse_number(n):
    result = 0
    while n > 0:
        result = result * 10 + n % 10
        n //= 10
    return result


def is_palindrome(n):
    return n == reverse_number(n)


print()
for n in [2026, 12321, 9875]:
    print(f"{n}: digit sum = {digit_sum(n)}, reversed = {reverse_number(n)}, "
          f"palindrome = {is_palindrome(n)}")

print('\nB. Count how many palindromes there are from 10 to 999.')
count = 0
for n in range(10, 1000):
    if is_palindrome(n):
        count += 1
print("Palindromes from 10 to 999:", count)
