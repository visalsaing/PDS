def letter_grade(score):
    
    if score < 0 or score > 100:
        return "Invalid"
    elif score >= 97:
        return "A+"
    elif score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    elif score < 60:
        return "D"
    else :
        return "F"

print('\nA. Test your function with the list')

test_scores = [99, 90, 85.5, 72, 60, 59.9, -5, 101]

for s in test_scores:
    print(f"{s:4} -> {letter_grade(s)}")

